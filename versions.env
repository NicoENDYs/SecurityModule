# versions.env — Central source of truth for Docker image versions used by all scripts.
# Source this file at the top of every bash script:
#   source "$SECURITY_ROOT/versions.env"
#
# Also consumed by docker/docker-compose.yml: the docker/.env symlink points
# here, so Docker Compose interpolates ${TRIVY_VERSION}, ${ZAP_VERSION}, etc.
# directly from this file.
#
# Update these when new stable releases are available and test before merging.
# Pin to exact tags (never :latest or :stable) to guarantee reproducibility.

TRIVY_VERSION=0.71.1
SEMGREP_VERSION=1.166.0
ZAP_VERSION=2.17.0
BENCH_VERSION=1.6.1
# Gitleaks tags are prefixed with "v" on Docker Hub (zricethezav/gitleaks:v<ver>);
# scripts/workflows add the "v" — store the bare version here, like the others.
GITLEAKS_VERSION=8.21.2
CHECKOV_VERSION=3.2.334

# Base images are pinned by digest (tags are mutable — a registry compromise
# could swap what a tag points to). update-versions.yml refreshes these digests
# weekly from the Docker Hub API alongside the tool versions above.
NODE_IMAGE=node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2
NGINX_IMAGE=nginx:alpine@sha256:54f2a904c251d5a34adf545a72d32515a15e08418dae0266e23be2e18c66fefa
